# Live mode: the agent calls Claude. Leave empty to use the offline simulator.
ANTHROPIC_API_KEY=

# Optional overrides
# AGENT_MODEL=claude-opus-5-5
# JUDGE_MODEL=claude-haiku-5-5
# AGENT_MODE=mock            # force the offline simulator even with a key

# Optional: mirror every LangGraph run to LangSmith (no code changes needed)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=evalops-lab
